{
  "sdkVersion": "1.0.0",
  "goldApi": "1.3.0",
  "ggApi": 5,
  "permissions": [
    "chat.read",
    "chat.write",
    "clipboard",
    "console",
    "events",
    "gold.ai",
    "gold.contacts",
    "gold.documents",
    "gold.documents.import",
    "gold.favorites",
    "gold.search",
    "gold.search.history",
    "gold.speech",
    "media.read",
    "messages.read",
    "network.fetch",
    "settings.read",
    "storage",
    "ui.mutate",
    "ui.read"
  ],
  "methods": [
    {
      "name": "ai.complete",
      "scope": "deepseek.explicit",
      "permissions": [
        "gold.ai",
        "network.fetch"
      ]
    },
    {
      "name": "ai.models",
      "scope": "deepseek.cache",
      "permissions": [
        "gold.ai",
        "network.fetch"
      ]
    },
    {
      "name": "ai.refreshModels",
      "scope": "deepseek.explicit",
      "permissions": [
        "gold.ai",
        "network.fetch"
      ]
    },
    {
      "name": "search.messages",
      "scope": "visibleSnapshot",
      "permissions": [
        "gold.search",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "documents.analyze",
      "scope": "providedText",
      "permissions": [
        "gold.documents"
      ]
    },
    {
      "name": "documents.saveText",
      "scope": "pluginFiles",
      "permissions": [
        "gold.documents",
        "storage"
      ]
    },
    {
      "name": "documents.readText",
      "scope": "pluginFiles",
      "permissions": [
        "gold.documents",
        "storage"
      ]
    },
    {
      "name": "documents.pickJSON",
      "scope": "userSelectedJSON",
      "permissions": [
        "gold.documents",
        "storage"
      ]
    },
    {
      "name": "documents.shareJSON",
      "scope": "userSelectedJSON",
      "permissions": [
        "gold.documents",
        "storage"
      ]
    },
    {
      "name": "speech.voices",
      "scope": "systemVoices",
      "permissions": [
        "gold.speech"
      ]
    },
    {
      "name": "speech.speak",
      "scope": "foregroundProvidedText",
      "permissions": [
        "gold.speech"
      ]
    },
    {
      "name": "speech.stop",
      "scope": "ownExecution",
      "permissions": [
        "gold.speech"
      ]
    },
    {
      "name": "favorites.search",
      "scope": "currentPeerMetadata",
      "permissions": [
        "gold.favorites",
        "chat.read"
      ]
    },
    {
      "name": "favorites.selected",
      "scope": "selectedReference",
      "permissions": [
        "gold.favorites",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "favorites.addSelected",
      "scope": "confirmedSelectedReference",
      "permissions": [
        "gold.favorites",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "favorites.removeSelected",
      "scope": "confirmedSelectedReference",
      "permissions": [
        "gold.favorites",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "contacts.current",
      "scope": "currentCloudUser",
      "permissions": [
        "gold.contacts",
        "chat.read"
      ]
    },
    {
      "name": "contacts.selected",
      "scope": "selectedCloudUserAuthor",
      "permissions": [
        "gold.contacts",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "search.history",
      "scope": "confirmedCurrentPeerHistory",
      "permissions": [
        "gold.search",
        "gold.search.history",
        "chat.read",
        "messages.read"
      ]
    },
    {
      "name": "documents.pickText",
      "scope": "userSelectedDocument",
      "permissions": [
        "gold.documents",
        "gold.documents.import"
      ]
    }
  ]
}
